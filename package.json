{
  "name": "learnkit",
  "version": "0.1.0",
  "description": "Dependency-free Web Components: accessible UI primitives and interactive learning components.",
  "type": "module",
  "main": "src/index.js",
  "style": "src/learnkit.css",
  "exports": {
    ".": "./src/index.js",
    "./css": "./src/learnkit.css",
    "./themes/*.css": "./src/themes/*.css",
    "./*.js": "./src/*.js"
  },
  "files": ["src", "docs"],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "node scripts/serve.mjs",
    "sync": "node scripts/sync-themes.mjs",
    "sync:check": "node scripts/sync-themes.mjs --check"
  },
  "keywords": ["web-components", "learning", "education", "elearning", "accessibility"],
  "license": "MIT",
  "private": true
}
